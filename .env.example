ENVIRONMENT=local
DATABASE_URL=postgresql://moneyway:moneyway@localhost:5432/moneyway
# Размер пула на инстанс: DB_POOL_MAX_SIZE * число инстансов < Postgres max_connections.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_AUX_POOL_MAX_SIZE=4

# Секреты обязательны вне local/test (см. Settings.validate_secure_production_settings).
# SECRET_KEY: длинная случайная строка (>= 32 символов).
SECRET_KEY=change-this-to-a-long-random-secret-min-32-chars
# WEBHOOK_SECRET: shared secret для аутентификации СБП-вебхуков. Пустой допустим
# только в local/test — вне их сервис не стартует, а вебхуки отвечают 503.
WEBHOOK_SECRET=change-this-to-a-long-random-webhook-secret

DEPOSIT_MIN_RUB=5000
DEPOSIT_MAX_RUB=50000
DEPOSIT_COMMISSION_PERCENT=2
RUB_USDT_RATE=100

BINGX_API_KEY=
BINGX_SECRET_KEY=
BINGX_BASE_URL=https://open-api.bingx.com
# recvWindow запросов BingX (мс, макс 60000) и HTTP-таймаут.
BINGX_RECV_WINDOW_MS=5000
BINGX_HTTP_TIMEOUT_SECONDS=10
# Холд перед отправкой USDT (мин) — окно на отмену по чарджбэку. Прод: 15–30, 0 = без холда.
BINGX_TRANSFER_HOLD_MINUTES=20
# Фолбэк-поллинг непрерывного воркера (сек).
WORKER_POLL_INTERVAL_SECONDS=5

# Допуск на рассинхрон часов при валидации JWT (сек).
JWT_LEEWAY_SECONDS=30

# Таймауты транзакции запроса (мс). 0 — выключить.
DB_STATEMENT_TIMEOUT_MS=10000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_IN_TX_TIMEOUT_MS=10000

# Порог зависшего processing-перевода для reaper воркера (сек).
BINGX_TRANSFER_STALE_SECONDS=300

# In-process rate limit. Прод должен дублировать на gateway/WAF.
RATE_LIMIT_ENABLED=true
# За reverse-proxy (nginx/traefik): брать реальный IP клиента из X-Real-IP. Только если
# перед сервисом есть доверенный прокси, который перезаписывает этот заголовок.
TRUSTED_PROXY=false

# Admin-панель (starlette-admin) на /admin. По умолчанию ВЫКЛ — включать осознанно и
# ограничивать доступ по сети (VPN/IP-allowlist). ADMIN_SESSION_SECRET — отдельный от SECRET_KEY.
ADMIN_ENABLED=false
ADMIN_SESSION_SECRET=change-this-to-another-long-random-secret

TRUSTED_HOSTS=localhost,127.0.0.1,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
